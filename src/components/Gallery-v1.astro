---
import { getImage } from "astro:assets";

const modules = import.meta.glob(
    "../assets/images/rocket_comics/rocket_comics_*.webp",
    { eager: true },
) as Record<string, { default: ImageMetadata }>;

// Captions/alt text lookup (Record makes captions[id] valid)
const captions: Record<string, string> = {
    "0": "An early advertisement for Rocket Comics in the Burlington-Times News",
    "1": "Rocket Comics Pre-Launch, August 1991",
    "2": "Inside Rocket Comics during construction, August 1991",
    "4": "Opening Day, October 1991",
    "5": "Welcome to Rocket Comics. Be our guest!",
    "6": "Open for business!",
    "7": "Open 7 days a week for your comic book needs!",
    "8": "The Rocketeer greets customers at the grand opening of Rocket Comics",
    "9": "Getting the day started at Rocket Comics",
    "10": "Hard at work in the upgraded cash register area of Rocket Comics",
    "11": "The original cash register area of Rocket Comics",
    "12": "The display cases at Rocket Comics, filled with collectibles and back issues",
    "13": "The back wall comics. This is where the expensive back issues were displayed.",
    "14": "A close-up of a display case at Rocket Comics, showcasing a variety of collectibles and back issues.",
    "15": "A close-up of another display case at Rocket Comics. Look at that cool Rancor figure from Kenner!",
    "16": "Limited Edition Superman prints by Jim Steranko and Frank Miller",
    "17": "A sample of posters and prints on display at Rocket Comics",
    "18": "A lighted display sign promoting Marvel Comics. Love the McFarlane Spider-Man",
    "19": "An Arkham Asylum promotional display",
    "21": "The graphic novel and novels corner",
    "22": "The even more expanded new comics racks",
    "23": "...and yet more new comics",
    "24": "Comic book supplies and more graphic novels",
    "25": "The expanded new comics racks",
    "26": "The original new comics racks...",
    "27": "Look at all the cool posters!",
    "28": "Stop reading comics and get back to work!",
    "29": "Helping customers find their next read in the back issues bullpen",
    "30": "The back issues bullpen's final form",
    "31": "A much smaller back issue bullpen from the early days at Rocket Comics",
    "32": "A view of Rocket Comics from the front door",
    "33": "The expanded back issues bullpen",
    "34": "The Toys and T-Shirts corner",
    "35": "How sweet! Someone sent flowers for our grand opening",
    "36": "More toys, models and cards",
    "37": "Looking into the store from the back office",
    "38": "Talking shop with some Rocket Comics Regulars",
    "39": "A little horse trading with a customer",
    "40": "Toys, model kits and more",
    "41": "The back office",
    "42": "A view of Rocket Comics from the back door",
    "44": "Teenage Mutant Ninja Turtles...Heroes on the Halfshell",
    "45": "Mack and Tripp slacking off...again!",
    "46": "Tripp is serious about his TMNT",
    "47": "The back office at Rocket Comics",
    "48": "Rocket Comics' Mission Control. The Mac Classic was awesome!",
    "49": "Friendly service even over the phone",
    "50": "Rocket Comics ran on ALOT of coffee",
    "51": "Craig Gilmore, a Rocket Comics employee, would go on to be a successful comic book artist",
    "52": "Playing Trivial Pursuit on a break with long time friend, Lynn. Mack is hiding in the shadows...like Batman.",
};

const zoomIds = new Set<string>([""]);

// Helper to make a srcset from widths
const makeSrcset = async (
    src: ImageMetadata,
    widths: number[],
    quality: number,
) => {
    const variants = await Promise.all(
        widths.map(async (w) => {
            const img = await getImage({
                src,
                width: w,
                format: "webp",
                quality,
            });
            return { w, src: img.src };
        }),
    );
    return variants
        .sort((a, b) => a.w - b.w)
        .map((v) => `${v.src} ${v.w}w`)
        .join(", ");
};

const images = await Promise.all(
    Object.entries(modules)
        .map(async ([path, mod]) => {
            const filename = path.split("/").pop() ?? "";
            const m = filename.match(/rocket_comics_(\d+)\.webp$/);
            const id = m?.[1] ?? "0";

            const src = mod.default;

            const filename_root = `rocket_comics_${id}`;
            const alt = captions[id] ?? `Rocket Comics photo #${id}`;
            const title = "Rocket Comics";

            // THUMB sizes tuned to your 350px columns
            const thumbWidths = [360, 420, 520, 840]; // 840 = 2x-ish for 420
            const thumbSrcset = await makeSrcset(src, thumbWidths, 60);

            // Pick a reasonable default thumb (browser may choose smaller via srcset)
            const thumbDefault = await getImage({
                src,
                width: 420,
                format: "webp",
                quality: 60,
            });

            // LIGHTBOX sizes tuned to your 1200px max display
            const lightWidths = [900, 1200, 1400, 1800]; // adjust up/down if you want
            const lightSrcset = await makeSrcset(src, lightWidths, 80);

            const lightDefault = await getImage({
                src,
                width: 1400,
                format: "webp",
                quality: 80,
            });

            return {
                id,
                alt,
                title,
                filename_root,

                thumbSrc: thumbDefault.src,
                thumbW: thumbDefault.attributes.width,
                thumbH: thumbDefault.attributes.height,
                thumbSrcset,

                lightSrc: lightDefault.src,
                lightW: lightDefault.attributes.width,
                lightH: lightDefault.attributes.height,
                lightSrcset,
            };
        })
        .sort((a, b) => Number(a.id) - Number(b.id)),
);
---

<div class="gallery">
    <header class="gallery__header">
        <h2 class="center">
            <i class="fa-utility-fill fa-semibold fa-rocket-launch"></i> Rocket Comics
            Memories
        </h2>
        <p class="center">
            <small
                ><i
                    >Please excuse the quality of some of these photos. Higher
                    quality scans are in the works.</i
                ></small
            >
        </p>
    </header>

    <div class="gallery-images">
        {
            images.map((img) => (
                <>
                    <figure class={zoomIds.has(img.id) ? "zoom" : undefined}>
                        <a
                            href={"#" + img.filename_root}
                            title={img.title}
                            class="thumb"
                        >
                            <img
                                src={img.thumbSrc}
                                srcset={img.thumbSrcset}
                                sizes="(max-width: 420px) 92vw, 350px"
                                width={img.thumbW}
                                height={img.thumbH}
                                alt={img.alt}
                                title={img.title}
                                loading="lazy"
                                decoding="async"
                            />
                        </a>
                        <figcaption>{img.alt}</figcaption>
                    </figure>

                    <div
                        id={img.filename_root}
                        tabindex="-1"
                        class="lightbox"
                        role="dialog"
                        aria-modal="true"
                        aria-label={img.alt}
                    >
                        <a
                            href="#!"
                            class="lightbox__overlay"
                            aria-label="Close"
                        />

                        <figure class="lightbox__content">
                            <img
                                src={img.lightSrc}
                                srcset={img.lightSrcset}
                                sizes="min(92vw, 1200px)"
                                width={img.lightW}
                                height={img.lightH}
                                alt={img.alt}
                                title={img.title}
                                loading="lazy"
                                decoding="async"
                            />
                            <figcaption>{img.alt}</figcaption>
                            <a
                                href="#!"
                                class="lightbox__close"
                                aria-label="Close"
                            >
                                ×
                            </a>
                        </figure>
                    </div>
                </>
            ))
        }
    </div>
</div>
