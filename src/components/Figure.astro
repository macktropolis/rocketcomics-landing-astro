---
const { id, alt, title } = Astro.props;
const src = "/images/rocket_comics";
const filename_root = "rocket_comics_" + id;
const filename = filename_root + ".webp";
const href = src + "/" + filename;
---

<figure>
    <a href={"#" + filename_root} title={title ?? "Rocket Comics"} class="thumb">
        <img
            src={href}
            alt={alt ?? "A day at Rocket Comics"}
            title={title ?? "Rocket Comics"}
            loading="lazy"
        />
    </a>

    <figcaption>{alt ?? "A day at Rocket Comics"}</figcaption>
</figure>

<div
    id={filename_root}
    tabindex="-1"
    class="lightbox"
    role="dialog"
    aria-modal="true"
    aria-label={alt ?? "A day at Rocket Comics"}
>
    <a href="#!" class="lightbox__overlay" aria-label="Close"></a>
    <figure class="lightbox__content">
        <img
            src={href}
            alt={alt ?? "A day at Rocket Comics"}
            title={title ?? "Rocket Comics"}
            loading="lazy"
        />

        <figcaption>{alt ?? "A day at Rocket Comics"}</figcaption>
        <a href="#!" class="lightbox__close" aria-label="Close">×</a>
    </figure>
</div>
