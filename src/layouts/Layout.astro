---
// data imports
import * as site from "../data/site.json";

import BaseHead from "../components/BaseHead.astro";
import BaseEnd from "../components/BaseEnd.astro";
import Header from "../components/Header.astro";
import Outro from "../components/Outro.astro";
import Footer from "../components/Footer.astro";

const { siteName, author, url, logo } = site;
---

<!doctype html>
<html lang="en">
	<BaseHead />
	<body>
		<div class="page">
			<Header siteName={siteName} author={author} url={url} logo={logo} />
			<main>
				<slot />
			</main>
			<Outro />
			<Footer />
			<div class="reg reg--tl"><div class="ring"></div></div>
			<div class="reg reg--tr"><div class="ring"></div></div>
			<div class="reg reg--bl"><div class="ring"></div></div>
			<div class="reg reg--br"><div class="ring"></div></div>
		</div>
		<BaseEnd />
	</body>
</html>
